# =========================================================
# Vibely Client Environment Variables (For Vercel Deployment)
# =========================================================

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Public Key (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Render Backend API URL (without trailing slash)
# In development: http://localhost:5000
# In production on Vercel: https://your-backend-name.onrender.com
VITE_API_URL=https://your-backend-name.onrender.com

# Optional Audius App Name
VITE_AUDIUS_APP_NAME=Vibely

